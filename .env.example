# Copie para .env e preencha. NUNCA versione o arquivo .env.

# --- Banco de dados (PostgreSQL) ---
POSTGRES_DB=marmitex
POSTGRES_USER=marmitex
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql+psycopg://marmitex:troque-esta-senha@db:5432/marmitex

# --- Segurança ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Aplicação ---
# Use "production" no notebook servidor (exige JWT_SECRET e senha do banco próprios).
ENVIRONMENT=production
APP_TIMEZONE=America/Sao_Paulo
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# --- Primeiro administrador (usado por: python -m app.cli create-admin) ---
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@exemplo.com.br
INITIAL_ADMIN_PASSWORD=troque-esta-senha-tambem

# --- Acesso ---
# 127.0.0.1 = somente este notebook (padrão, mais seguro).
# 0.0.0.0   = libera o acesso de outro notebook na mesma rede (INSTALL.md, seção 7).
ACESSO_IP=127.0.0.1

# --- Backup automático (serviço "backup" do docker compose) ---
BACKUP_HOUR=23
BACKUP_RETENTION_DAYS=30

# --- Testes (opcional, desenvolvimento) ---
TEST_DATABASE_URL=postgresql+psycopg://marmitex:troque-esta-senha@localhost:5432/marmitex_test
